{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vimwilds.local/schemas/presentation.schema.json",
  "title": "Vim Wilds presentation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "worlds", "units", "story"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "worlds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/world" }
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/unit" }
    },
    "story": { "$ref": "#/$defs/story" },
    "reference": { "$ref": "#/$defs/referenceSurface" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "asset": {
      "type": "string",
      "pattern": "^assets/[a-z0-9][a-z0-9./-]*\\.(?:png|webp|svg)$"
    },
    "world": {
      "type": "object",
      "required": ["id", "displayName", "autoThemeId", "ambientEffects", "fallbackGradient"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "autoThemeId": { "enum": ["moonroot", "ember", "glass", "deepwater"] },
        "ambientEffects": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "fallbackGradient": { "type": "string", "minLength": 1 }
      },
      "description": "World identity and ambient language only. All board imagery is registered on each unit scene."
    },
    "patchBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "sceneProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "patches"],
      "properties": {
        "base": { "$ref": "#/$defs/asset" },
        "focalPosition": { "type": "string", "minLength": 1 },
        "patches": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "phasePatches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explain", "demonstrate", "isolate", "mix", "challenge", "summary"],
      "properties": {
        "explain": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "demonstrate": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "isolate": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "mix": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "challenge": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "summary": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "remoteVariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "registrationProfile", "assetRoot", "siteIds", "variantsPerSite", "timing"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["tall", "compact", "wide"] },
          "uniqueItems": true
        },
        "registrationProfile": { "enum": ["tall", "compact", "wide"] },
        "mode": { "enum": ["complete-board", "transparent-patch"] },
        "assetRoot": { "type": "string", "pattern": "^assets/[a-z0-9][a-z0-9./-]*$" },
        "format": { "enum": ["png", "webp"] },
        "siteIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "variantsPerSite": { "type": "integer", "minimum": 1, "maximum": 20 },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialDelayMs", "fadeMs", "holdMs", "gapMs"],
          "properties": {
            "initialDelayMs": { "type": "number", "minimum": 0 },
            "fadeMs": { "type": "number", "minimum": 0 },
            "holdMs": { "type": "number", "minimum": 0 },
            "gapMs": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "standaloneSceneProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": { "$ref": "#/$defs/asset" },
        "focalPosition": { "type": "string", "minLength": 1 }
      }
    },
    "standaloneScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profiles"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tall", "compact", "wide"],
          "properties": {
            "tall": { "$ref": "#/$defs/standaloneSceneProfile" },
            "compact": { "$ref": "#/$defs/standaloneSceneProfile" },
            "wide": { "$ref": "#/$defs/standaloneSceneProfile" }
          }
        },
        "remoteVariants": { "$ref": "#/$defs/remoteVariants" }
      }
    },
    "referenceSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldId", "sceneId", "scene"],
      "properties": {
        "worldId": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/id" },
        "landmarkId": { "$ref": "#/$defs/id" },
        "scene": { "$ref": "#/$defs/standaloneScene" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patchRegions", "profiles", "phasePatches", "landmarkPatches"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "patchRegions": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 3,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/patchBounds" }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tall", "compact", "wide"],
          "properties": {
            "tall": { "$ref": "#/$defs/sceneProfile" },
            "compact": { "$ref": "#/$defs/sceneProfile" },
            "wide": { "$ref": "#/$defs/sceneProfile" }
          }
        },
        "phasePatches": { "$ref": "#/$defs/phasePatches" },
        "remoteVariants": { "$ref": "#/$defs/remoteVariants" },
        "landmarkPatches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dormant", "restored"],
          "properties": {
            "dormant": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "restored": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "worldId", "guideCharacterId", "landmark", "completion"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "worldId": { "$ref": "#/$defs/id" },
        "guideCharacterId": { "$ref": "#/$defs/id" },
        "sceneId": { "$ref": "#/$defs/id" },
        "scenes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/scene" }
        },
        "landmark": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }
          },
          "description": "Story identity. Historical asset and placement fields may remain until that unit receives registered landmark patches."
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actionId", "action", "copy", "nextHook"],
          "properties": {
            "actionId": { "$ref": "#/$defs/id" },
            "storyBackdrop": { "$ref": "#/$defs/asset" },
            "storyImage": { "$ref": "#/$defs/asset" },
            "action": { "type": "string", "minLength": 1 },
            "copy": { "type": "string", "minLength": 1 },
            "nextHook": {
              "type": "object",
              "additionalProperties": false,
              "required": ["copy"],
              "properties": {
                "speaker": { "type": "string", "minLength": 1 },
                "copy": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "storyPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset", "copy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "asset": {
          "description": "Approved local story still. Null keeps the CSS placeholder active until WP-11 integrates reviewed art.",
          "anyOf": [
            { "$ref": "#/$defs/asset" },
            { "type": "null" }
          ]
        },
        "speaker": { "type": "string", "minLength": 1 },
        "copy": { "type": "string", "minLength": 1 }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writingPenAsset", "intro", "ending"],
      "properties": {
        "writingPenAsset": { "$ref": "#/$defs/asset" },
        "intro": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/storyPanel" }
        },
        "ending": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "speaker", "copy"],
          "properties": {
            "asset": { "$ref": "#/$defs/asset" },
            "speaker": { "type": "string", "minLength": 1 },
            "copy": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
