      "id": "analytics-sql",
      "fileName": "analytics.sql",
      "languageId": "sql",
      "summary": "Analytics queries with mixed keyword casing",
      "lines": [
        "-- Monthly signups by region",
        "SELECT region,",
        "       trunc_month(made) AS m,",
        "       count(*) AS signups",
        "FROM users",
        "WHERE made >= '2026-01-01'",
        "GROUP BY region, m",
        "ORDER BY m, region;",
        "",
        "-- churned accounts",
        "select id, name, region, closed",
        "from accounts",
        "where closed is not null",
        "  and plan <> 'trial'",
        "order by closed desc",
        "limit 50;",
        "",
        "-- Revenue per plan",
        "SELECT plan,",
        "       sum(amount) AS revenue,",
        "       avg(amount) AS mean",
        "FROM invoices",
        "WHERE paid = true",
        "GROUP BY plan",
        "HAVING sum(amount) > 10000",
        "ORDER BY revenue DESC;",
        "",
        "-- stale sessions",
        "select user_id, count(*) as n",
        "from sessions",
        "where seen_at < now() - '90 days'",
        "group by user_id",
        "having count(*) > 3;"
      ]
    },
    {
      "id": "release-shell",
      "fileName": "release.sh",
      "languageId": "shell",
      "summary": "Release script with flags and early exits",
      "lines": [
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        "",
        "APP=\"atlas\"",
        "REG=\"registry.internal\"",
        "VER=\"${1:-}\"",
        "",
        "if [ -z \"$VER\" ]; then",
        "  echo \"usage: release VER\" >&2",
        "  exit 1",
        "fi",
        "",
        "if ! git diff --quiet; then",
        "  echo \"working tree is dirty\" >&2",
        "  exit 1",
        "fi",
        "",
        "echo \"==> building $APP $VER\"",
        "npm ci",
        "npm run build",
        "",
        "echo \"==> tagging\"",
        "git tag -a \"v$VER\" -m \"$VER\"",
        "git push origin \"v$VER\"",
        "",
        "echo \"==> pushing image\"",
        "docker build -t \"$APP:$VER\" .",
        "docker tag \"$APP:$VER\" \\",
        "  \"$REG/$APP:$VER\"",
        "docker push \"$REG/$APP:$VER\"",
        "",
        "echo \"==> done\""
      ]
    },
