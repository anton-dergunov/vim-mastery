      "id": "cart-javascript",
      "fileName": "cart.js",
      "languageId": "javascript",
      "summary": "Shopping cart helpers with uneven guard clauses",
      "lines": [
        "const TAX = 0.0825;",
        "const FREE_SHIP = 75;",
        "",
        "const OFF = {",
        "  HELLO: 0.05,",
        "  SPRING: 0.15,",
        "  VIP: 0.25,",
        "};",
        "",
        "function round2(n) {",
        "  const c = Math.round(n * 100);",
        "  return c / 100;",
        "}",
        "",
        "function subtotal(items) {",
        "  let sum = 0;",
        "  for (const it of items) {",
        "    sum += it.price * it.qty;",
        "  }",
        "  return sum;",
        "}",
        "",
        "function cut(code, amt) {",
        "  const rate = OFF[code] || 0;",
        "  return round2(amt * rate);",
        "}",
        "",
        "function ship(amt, fast) {",
        "  if (amt >= FREE_SHIP) return 0;",
        "  if (fast) return 24.5;",
        "  return 6.95;",
        "}",
        "",
        "function total(cart, code, fast) {",
        "  const base = subtotal(cart);",
        "  const off = cut(code, base);",
        "  const net = base - off;",
        "  const s = ship(net, fast);",
        "  const tax = net * TAX;",
        "  return round2(net + tax + s);",
        "}",
        "",
        "module.exports = { total, cut };"
      ]
    },
