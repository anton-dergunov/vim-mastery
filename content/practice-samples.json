      "id": "ingest-python",
      "fileName": "ingest.py",
      "languageId": "python",
      "summary": "Batch loader with retries and mixed logging",
      "lines": [
        "import csv",
        "import logging",
        "",
        "log = logging.getLogger(__name__)",
        "",
        "RETRIES = 3",
        "BATCH = 250",
        "",
        "",
        "def read_rows(path):",
        "    fh = open(path, newline=\"\")",
        "    return csv.DictReader(fh)",
        "",
        "",
        "def clean(row):",
        "    mail = row[\"email\"]",
        "    row[\"email\"] = mail.lower()",
        "    name = row[\"name\"]",
        "    row[\"name\"] = name.strip()",
        "    if not row.get(\"country\"):",
        "        row[\"country\"] = \"unknown\"",
        "    return row",
        "",
        "",
        "def send(batch, cli):",
        "    try:",
        "        cli.send(batch)",
        "        return True",
        "    except TimeoutError:",
        "        return False",
        "",
        "",
        "def push(batch, cli):",
        "    for n in range(RETRIES):",
        "        if send(batch, cli):",
        "            return True",
        "        log.warning(\"retry %s\", n)",
        "    log.error(\"batch dropped\")",
        "    return False",
        "",
        "",
        "def run(path, cli):",
        "    batch = []",
        "    for row in read_rows(path):",
        "        batch.append(clean(row))",
        "        if len(batch) >= BATCH:",
        "            push(batch, cli)",
        "            batch = []",
        "    if batch:",
        "        push(batch, cli)"
      ]
    },
