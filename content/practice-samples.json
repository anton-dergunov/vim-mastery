        "      - uses: actions/checkout@v4",
        "      - run: npm ci",
        "      - run: npm run build",
        "      - uses: actions/upload@v4",
        "        with:",
        "          name: dist",
        "          path: dist/",
        "",
        "  deploy:",
        "    runs-on: ubuntu-latest",
        "    needs: build",
        "    if: success()",
        "    steps:",
