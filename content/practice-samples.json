      "id": "server-go",
      "fileName": "server.go",
      "languageId": "go",
      "summary": "HTTP server with handlers of uneven length",
      "lines": [
        "package main",
        "",
        "import (",
        "    \"encoding/json\"",
        "    \"log\"",
        "    \"net/http\"",
        "    \"time\"",
        ")",
        "",
        "type Status struct {",
        "    OK  bool   `json:\"ok\"`",
        "    Ver string `json:\"ver\"`",
        "}",
        "",
        "var ver = \"0.4.1\"",
        "",
        "func health(w http.ResponseWriter,",
        "    r *http.Request) {",
        "    s := Status{true, ver}",
        "    json.NewEncoder(w).Encode(s)",
        "}",
        "",
        "func slow(w http.ResponseWriter,",
        "    r *http.Request) {",
        "    time.Sleep(2 * time.Second)",
        "    w.Write([]byte(\"done\"))",
        "}",
        "",
        "func boom(w http.ResponseWriter,",
        "    r *http.Request) {",
        "    http.Error(w, \"nope\", 500)",
        "}",
        "",
        "func main() {",
        "    mux := http.NewServeMux()",
        "    mux.HandleFunc(\"/up\", health)",
        "    mux.HandleFunc(\"/slow\", slow)",
        "    mux.HandleFunc(\"/boom\", boom)",
        "    log.Println(\"listening :8080\")",
        "    log.Fatal(http.ListenAndServe(",
        "        \":8080\", mux))",
        "}"
      ]
    },
    {
      "id": "parser-rust",
      "fileName": "parser.rs",
      "languageId": "rust",
      "summary": "Token lexer with a wide match arm block",
      "lines": [
        "#[derive(Debug, Clone)]",
        "pub enum Tok {",
        "    Word(String),",
        "    Num(i64),",
        "    Sym(char),",
        "    Space,",
        "    End,",
        "}",
        "",
        "pub fn label(t: &Tok) -> String {",
        "    use Tok::*;",
        "    match t {",
        "        Word(w) => w.clone(),",
        "        Num(n) => n.to_string(),",
        "        Sym(c) => c.to_string(),",
        "        Space => \" \".into(),",
        "        End => String::new(),",
        "    }",
        "}",
        "",
        "fn classify(c: char) -> Tok {",
        "    if c.is_whitespace() {",
        "        return Tok::Space;",
        "    }",
        "    if c.is_ascii_digit() {",
        "        let n = c as i64 - 48;",
        "        return Tok::Num(n);",
        "    }",
        "    Tok::Sym(c)",
        "}",
        "",
        "pub fn lex(s: &str) -> Vec<Tok> {",
        "    let mut out = Vec::new();",
        "    for c in s.chars() {",
        "        out.push(classify(c));",
        "    }",
        "    out.push(Tok::End);",
        "    out",
        "}",
        "",
        "impl Tok {",
        "    pub fn is_end(&self) -> bool {",
        "        matches!(self, Tok::End)",
        "    }",
        "}"
      ]
    },
