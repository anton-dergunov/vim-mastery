      "id": "routes-typescript",
      "fileName": "routes.ts",
      "languageId": "typescript",
      "summary": "Express route table with scattered auth guards",
      "lines": [
        "import { Router } from \"express\";",
        "import { auth } from \"./auth\";",
        "import * as h from \"./handlers\";",
        "",
        "const api = Router();",
        "",
        "api.get(\"/health\", h.health);",
        "api.get(\"/users\", h.list);",
        "api.post(\"/users\", auth, h.make);",
        "api.get(\"/users/:id\", h.show);",
        "api.put(\"/users/:id\", h.edit);",
        "api.delete(\"/users/:id\", h.drop);",
        "api.get(\"/orders\", h.orders);",
        "api.post(\"/orders\", auth, h.add);",
        "api.get(\"/orders/:id\", h.order);",
        "api.patch(\"/orders/:id\", h.touch);",
        "api.get(\"/reports\", h.reports);",
        "api.post(\"/reports\", h.build);",
        "api.get(\"/reports/:id\", h.report);",
        "",
        "// TODO: rate limit the writes",
        "api.post(\"/webhook\", h.hook);",
        "api.post(\"/replay\", h.replay);",
        "",
        "export default api;"
      ]
    },
