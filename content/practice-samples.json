      "id": "report-python",
      "fileName": "report.py",
      "languageId": "python",
      "summary": "Report builder with ragged dict literals",
      "lines": [
        "from datetime import date",
        "",
        "REGIONS = {",
        "    \"emea\": \"Europe\",",
        "    \"apac\": \"Asia Pacific\",",
        "    \"na\": \"North America\",",
        "    \"latam\": \"Latin America\",",
        "}",
        "",
        "TARGETS = {",
        "    \"emea\": 120_000,",
        "    \"apac\": 98_000,",
        "    \"na\": 250_000,",
        "    \"latam\": 42_000,",
        "}",
        "",
        "",
        "def pct(got, target):",
        "    if not target:",
        "        return 0.0",
        "    share = got / target * 100",
        "    return round(share, 1)",
        "",
        "",
        "def rank(row):",
        "    return -row[\"pct\"]",
        "",
        "",
        "def summarise(totals):",
        "    rows = []",
        "    for key in REGIONS:",
        "        got = totals.get(key, 0)",
        "        tgt = TARGETS[key]",
        "        rows.append({",
        "            \"name\": REGIONS[key],",
        "            \"got\": got,",
        "            \"target\": tgt,",
        "            \"pct\": pct(got, tgt),",
        "        })",
        "    rows.sort(key=rank)",
        "    return rows",
        "",
        "",
        "def render(rows):",
        "    day = date.today()",
        "    print(\"Report\", day)",
        "    for r in rows:",
        "        print(r[\"name\"], r[\"pct\"])"
      ]
    },
