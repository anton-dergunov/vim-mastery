{
  "name": "vim-wilds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "patch-package",
    "test": "npm run test:quick",
    "test:quick": "npm run test:content && npm run test:effects && npm run test:native && npm run test:media && npm run test:browser:smoke",
    "test:full": "npm run test:content && npm run test:effects && npm run test:native && npm run test:media && npm run test:pwa && npm run test:browser",
    "test:content": "node --test tests/content-data.test.mjs tests/action-guidance.test.mjs tests/character-reactions.test.mjs tests/practice-samples.test.mjs tests/mastery-progress.test.mjs tests/field-notes.test.mjs",
    "test:effects": "node --test tests/vim-effects.test.mjs",
    "test:native": "node --test tests/native-vim.test.mjs",
    "test:media": "node --test tests/media-policy.test.mjs",
    "test:pwa": "node --test tests/pwa-build.test.mjs",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test tests/smoke.spec.js --workers=1",
    "test:targeted": "playwright test --workers=1 --max-failures=1",
    "test:exhaustive": "playwright test --grep @exhaustive"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/highlight": "1.2.3",
    "@replit/codemirror-vim": "6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "patch-package": "^8.0.1",
    "vite": "8.1.4"
  }
}
